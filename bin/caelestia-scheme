def lab2rgb(l, a, b):
    fy = (l + 16) / 116
    fx, fz = fy + a / 500, fy - b / 200
    f = lambda t: t ** 3 if t > 6 / 29 else 3 * (6 / 29) ** 2 * (t - 4 / 29)
    x, y, z = .95047 * f(fx), f(fy), 1.08883 * f(fz)
    lin = (3.2406 * x - 1.5372 * y - .4986 * z,
           -.9689 * x + 1.8758 * y + .0415 * z,
           .0557 * x - .204 * y + 1.057 * z)
    return lin


def rgb2lab(r, g, b):
    def d(c):
        c /= 255
        return c / 12.92 if c <= .04045 else ((c + .055) / 1.055) ** 2.4
    r, g, b = d(r), d(g), d(b)
    x = (.4124 * r + .3576 * g + .1805 * b) / .95047
    y = .2126 * r + .7152 * g + .0722 * b
    z = (.0193 * r + .1192 * g + .9505 * b) / 1.08883
    f = lambda t: t ** (1 / 3) if t > (6 / 29) ** 3 else t / (3 * (6 / 29) ** 2) + 4 / 29
    return 116 * f(y) - 16, 500 * (f(x) - f(y)), 200 * (f(y) - f(z))


def tone(h, c, t):
    """Colour at lightness t (M3 tone = L*) and hue h, losing chroma to stay in sRGB."""
    while True:
        lin = lab2rgb(t, c * math.cos(h), c * math.sin(h))
        if c <= 0 or all(-.0005 <= v <= 1.0005 for v in lin):
            break
        c = max(0, c - 1)
    e = lambda v: 12.92 * v if v <= .0031308 else 1.055 * v ** (1 / 2.4) - .055
    return '#%02x%02x%02x' % tuple(round(min(1, max(0, e(max(0, v)))) * 255) for v in lin)


def seed_hue(path):
    """Remembered per image, because decoding a large wallpaper is most of a theme switch."""
    cache = HOME / '.cache/caelestia-gnome/seed-hue.json'
    try:
        known = json.loads(cache.read_text())
    except (OSError, ValueError):
        known = {}
    try:
        key = f'{path}:{os.stat(path).st_mtime_ns}'
    except OSError:
        return math.radians(270)   # no wallpaper file (a plain colour, or it was moved): a calm violet
    if key not in known:
        try:
            hue = measure_hue(path)
        except Exception as e:      # a format Pillow cannot read (SVG, JXL, XML slideshow)
            print(f'caelestia-scheme: cannot read colours from {path} ({e}); using the default hue', file=sys.stderr)
            hue = math.radians(270)
        known = {key: hue, **dict(list(known.items())[:40])}
        atomic(cache, json.dumps(known))
    return known[key]


def measure_hue(path):
    from PIL import Image
    im = Image.open(path).convert('RGB')
    im.thumbnail((160, 160))
    bins = [0.0] * 72
    px = im.getdata() if not hasattr(im, 'get_flattened_data') else im.get_flattened_data()
    for r, g, b in px:
        l, a, bb = rgb2lab(r, g, b)
        c = math.hypot(a, bb)
        if c < 8 or l < 8:
            continue
        bins[int((math.atan2(bb, a) % math.tau) / math.tau * 72) % 72] += c * c
    if not any(bins):
        return math.radians(270)
    # Smooth over neighbouring hues so a noisy peak cannot beat a broad one.
    best = max(range(72), key=lambda i: sum(bins[(i + d) % 72] for d in range(-3, 4)))
    return (best + .5) / 72 * math.tau


def scheme(h, variant='tonalspot', mode='dark'):
    _, pc, sc, tc, shift, n, v, hshift = VARIANTS[variant]
    p = h + math.radians(hshift)
    t = p + math.radians(shift)
    d = mode == 'dark'
    # M3 tone pairs: (dark, light).
    T = lambda dark, light: dark if d else light
    pair = lambda name, hue, c: {
        name: tone(hue, c, T(80, 40)), 'on' + name[0].upper() + name[1:]: tone(hue, c, T(20, 100)),
        name + 'Container': tone(hue, c, T(30, 90)), 'on' + name[0].upper() + name[1:] + 'Container': tone(hue, c, T(90, 10)),
    }
    return {
        **pair('primary', p, pc), **pair('secondary', p, sc), **pair('tertiary', t, tc),
        'error': T('#ffb4ab', '#ba1a1a'), 'onError': T('#690005', '#ffffff'),
        'errorContainer': T('#93000a', '#ffdad6'), 'onErrorContainer': T('#ffdad6', '#410002'),
        'success': T('#b5ccba', '#386a20'), 'onSuccess': T('#213528', '#ffffff'),
        'surface': tone(p, n, T(6, 98)), 'surfaceDim': tone(p, n, T(6, 87)), 'surfaceBright': tone(p, n, T(24, 98)),
        'surfaceContainerLowest': tone(p, n, T(4, 100)), 'surfaceContainerLow': tone(p, n, T(10, 96)),
        'surfaceContainer': tone(p, n, T(12, 94)), 'surfaceContainerHigh': tone(p, n, T(17, 92)),
        'surfaceContainerHighest': tone(p, n, T(22, 90)), 'onSurface': tone(p, n, T(90, 10)),
        'surfaceVariant': tone(p, v, T(30, 90)), 'onSurfaceVariant': tone(p, v, T(80, 30)),
        'outline': tone(p, v, T(60, 50)), 'outlineVariant': tone(p, v, T(30, 80)),
    }


def rgb(c):
    return [int(c[i:i + 2], 16) for i in (1, 3, 5)]


def mix(a, b, k):
    return '#%02x%02x%02x' % tuple(round(x + (y - x) * k) for x, y in zip(rgb(a), rgb(b)))


def rgba(c, a):
    return 'rgba(%d, %d, %d, %s)' % (*rgb(c), a)


def lum(c):
    return .2126 * rgb(c)[0] + .7152 * rgb(c)[1] + .0722 * rgb(c)[2]


def from_palette(pid):
    """Map a published palette onto the roles the shell and apps read."""
    _, mode, values = PALETTES[pid]
    bg, low, lowest, cont, high, outline, on, onv, pri, sec, ter, err, ok = values.split()
    d = mode == 'dark'
    pair = lambda name, c: {
        name: c, 'on' + name[0].upper() + name[1:]: mix(c, lowest, .8) if lum(c) > 110 else '#ffffff',
        name + 'Container': mix(bg, c, .32), 'on' + name[0].upper() + name[1:] + 'Container': mix(c, on, .55),
    }
    return {
        **pair('primary', pri), **pair('secondary', sec), **pair('tertiary', ter),
        'error': err, 'onError': mix(err, lowest, .8) if lum(err) > 110 else '#ffffff',
        'errorContainer': mix(bg, err, .35), 'onErrorContainer': mix(err, on, .6),
        'success': ok, 'onSuccess': mix(ok, lowest, .8) if lum(ok) > 110 else '#ffffff',
        'surface': bg, 'surfaceDim': mix(bg, lowest, .5), 'surfaceBright': high,
        'surfaceContainerLowest': lowest, 'surfaceContainerLow': low,
        'surfaceContainer': mix(bg, cont, .6), 'surfaceContainerHigh': cont, 'surfaceContainerHighest': high,
        'onSurface': on, 'surfaceVariant': cont, 'onSurfaceVariant': onv,
        'outline': outline, 'outlineVariant': high,
    }


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


def fill(template, s):
    for k in sorted(s, key=len, reverse=True):
        template = template.replace('{{%s}}' % k, s[k])
    return template


def shell_css(s, tokens, mode):
    extra = {
        'b': str(tokens['border']),
        # Washes that sit over album art, so they must keep the text readable in either mode.
        'scrim': rgba(mix(s['surface'], s['surfaceContainer'], .5), .78 if mode == 'dark' else .85),
        'hoverWash': rgba(s['onSurface'], .1),
    }
    css = fill((EXT / 'theme.tpl.css').read_text(), {**s, **extra})
    k = tokens['rounding'] / 25
    if k != 1:
        css = re.sub(r'border-radius: ([^;]+);', lambda m: 'border-radius: %s;' % ' '.join(
            f'{max(0, round(int(v[:-2]) * k))}px' if v.endswith('px') else v for v in m.group(1).split()), css)
    return css


def gtk_css(s):
    return f"""/* Generated by caelestia-scheme */
@define-color accent_color {s['primary']};
@define-color accent_bg_color {s['primary']};
@define-color accent_fg_color {s['onPrimary']};
@define-color window_bg_color {s['surface']};
@define-color window_fg_color {s['onSurface']};
@define-color view_bg_color {s['surfaceContainerLow']};
@define-color view_fg_color {s['onSurface']};
@define-color headerbar_bg_color {s['surface']};
@define-color headerbar_fg_color {s['onSurface']};
@define-color headerbar_border_color {s['surfaceContainer']};
@define-color headerbar_backdrop_color {s['surface']};
@define-color headerbar_shade_color alpha(black, .24);
@define-color sidebar_bg_color {s['surfaceContainerLow']};
@define-color sidebar_fg_color {s['onSurface']};
@define-color sidebar_backdrop_color {s['surface']};
@define-color sidebar_shade_color alpha(black, .2);
@define-color secondary_sidebar_bg_color {s['surfaceContainer']};
@define-color card_bg_color {s['surfaceContainer']};
@define-color card_fg_color {s['onSurface']};
@define-color dialog_bg_color {s['surfaceContainerHigh']};
@define-color dialog_fg_color {s['onSurface']};
@define-color popover_bg_color {s['surfaceContainerHigh']};
@define-color popover_fg_color {s['onSurface']};
@define-color thumbnail_bg_color {s['surfaceContainer']};
@define-color thumbnail_fg_color {s['onSurface']};
@define-color borders alpha({s['outlineVariant']}, .5);
"""


def ptyxis(s):
    a = [s['surfaceContainerHigh'], s['error'], s['success'], s['tertiary'], s['primary'],
         s['secondary'], s['tertiary'], s['onSurfaceVariant'], s['outline'], s['error'],
         s['success'], s['tertiary'], s['primary'], s['secondary'], s['tertiary'], s['onSurface']]
    colors = '\n'.join(f'Color{i}={c}' for i, c in enumerate(a))
    body = f"Background={s['surface']}\nForeground={s['onSurface']}\nTitlebarBackground={s['surface']}\n" \
           f"TitlebarForeground={s['onSurface']}\nCursor={s['primary']}\n{colors}\n"
    return f"[Palette]\nName=Caelestia\nPrimary=true\n\n[Dark]\n{body}\n[Light]\n{body}"


def current_wallpaper():
    uri = subprocess.check_output(
        ['gsettings', 'get', 'org.gnome.desktop.background', 'picture-uri-dark'], text=True).strip().strip("'")
    return unquote(urlparse(uri).path)


def load_state():
    st = dict(DEFAULTS)
    try:
        st.update(json.loads(STATE.read_text()))
    except (OSError, ValueError):
        pass
    return st


def saved_profiles():
    out = {}
    if PROFILES.is_dir():
        for f in sorted(PROFILES.glob('*.json')):
            try:
                out[f.stem] = json.loads(f.read_text())
            except ValueError:
                pass
    return out


def slug(name):
    return re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-') or 'rice'


def colours_for(st, hue):
    if st['palette'] != 'dynamic' and st['palette'] in PALETTES:
        return from_palette(st['palette'])
    return scheme(hue, st.get('variant', 'tonalspot') if st.get('variant') in VARIANTS else 'tonalspot', st.get('mode', 'dark'))


def swatch(s):
    return [s['surface'], s['surfaceContainerHigh'], s['primary'], s['secondary'], s['tertiary'], s['onSurface']]


def thumb(path):
    src = Path(path)
    key = hashlib.sha1(f'{src}:{src.stat().st_mtime_ns}'.encode()).hexdigest()
    out = THUMBS / f'{key}.jpg'
    if not out.exists():
        from PIL import Image
        THUMBS.mkdir(parents=True, exist_ok=True)
        im = Image.open(src).convert('RGB')
        im.thumbnail((352, 352))
        im.save(out, quality=85)
    return str(out)


def wallpapers():
    out = []
    for d in WALL_DIRS:
        if not d.is_dir():
            continue
        for f in sorted(d.iterdir()):
            if f.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp'):
                try:
                    out.append({'path': str(f), 'thumb': thumb(f), 'name': f.stem})
                except OSError:
                    pass
    return out


def write_catalog(st, hue, wall):
    profiles = []
    for pid, (name, pal, var, motion, corners, border, mode) in BUILTIN.items():
        c = colours_for({'palette': pal, 'variant': var, 'mode': mode}, hue)
        profiles.append({'id': pid, 'name': name, 'swatch': swatch(c), 'motion': motion, 'corners': corners, 'mode': mode, 'custom': False})
    for pid, p in saved_profiles().items():
        c = colours_for(p, hue)
        profiles.append({'id': pid, 'name': p.get('name', pid), 'swatch': swatch(c), 'motion': p.get('motion', 'fluid'),
                         'corners': p.get('corners', 'round'), 'mode': p.get('mode', 'dark'), 'custom': True})
    palettes = [{'id': 'dynamic', 'name': 'From wallpaper', 'swatch': swatch(scheme(hue, st['variant'] if st['variant'] in VARIANTS else 'tonalspot', st['mode']))}]
    palettes += [{'id': pid, 'name': v[0], 'swatch': swatch(from_palette(pid))} for pid, v in PALETTES.items()]
    atomic(OUT / 'themes.json', json.dumps({
        'current': {**st, 'wallpaper': wall}, 'profiles': profiles, 'palettes': palettes,
        'variants': [{'id': k, 'name': v[0]} for k, v in VARIANTS.items()], 'wallpapers': wallpapers(),
    }))


def gset(schema, key, value):
    subprocess.run(['gsettings', 'set', schema, key, value], check=False, stderr=subprocess.DEVNULL)


# GNOME's accent names and the matching Yaru theme.
ACCENTS = [(25, 'orange', ''), (0, 'red', 'red'), (55, 'yellow', 'yellow'), (130, 'green', 'sage'),
           (180, 'teal', 'viridian'), (225, 'blue', 'blue'), (280, 'purple', 'purple'), (325, 'pink', 'magenta')]


def sync_gnome(s, mode):
    r, g, b = rgb(s['primary'])
    _, aa, bb = rgb2lab(r, g, b)
    if math.hypot(aa, bb) < 10:
        accent, yaru = 'slate', ''
    else:
        deg = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)[0] * 360
        _, accent, yaru = min(ACCENTS, key=lambda a: min(abs(a[0] - deg), 360 - abs(a[0] - deg)))
    gset('org.gnome.desktop.interface', 'color-scheme', 'prefer-dark' if mode == 'dark' else 'default')
    gset('org.gnome.desktop.interface', 'accent-color', accent)
    base = f'Yaru-{yaru}' if yaru else 'Yaru'
    name = base + ('-dark' if mode == 'dark' else '')
    if Path(f'/usr/share/themes/{name}').is_dir():
        gset('org.gnome.desktop.interface', 'gtk-theme', name)
    if Path(f'/usr/share/icons/{name}').is_dir():
        gset('org.gnome.desktop.interface', 'icon-theme', name)


def set_wallpaper(path):
    uri = Path(path).as_uri()
    gset('org.gnome.desktop.background', 'picture-uri', uri)
    gset('org.gnome.desktop.background', 'picture-uri-dark', uri)
    gset('org.gnome.desktop.screensaver', 'picture-uri', uri)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('wallpaper', nargs='?')
    ap.add_argument('--profile')
    ap.add_argument('--palette', choices=['dynamic', *PALETTES])
    ap.add_argument('--variant', choices=list(VARIANTS))
    ap.add_argument('--mode', choices=['dark', 'light'])
    ap.add_argument('--motion', choices=['fluid', 'expressive', 'calm', 'snappy', 'off'])
    ap.add_argument('--corners', choices=list(RADIUS))
    ap.add_argument('--border', choices=list(BORDER))
    ap.add_argument('--save', metavar='NAME')
    ap.add_argument('--delete', metavar='NAME')
    ap.add_argument('--list', action='store_true')
    a = ap.parse_args()

    st = load_state()
    wall = a.wallpaper or current_wallpaper()
    hue = seed_hue(wall)

    if a.list:
        for pid, v in BUILTIN.items():
            print(f'{pid:<14} {v[0]} ({v[1]}, {v[3]}, {v[4]})')
        for pid, p in saved_profiles().items():
            print(f"{pid:<14} {p.get('name', pid)} (saved)")
        print('\npalettes: dynamic ' + ' '.join(PALETTES))
        return
    if a.save:
        PROFILES.mkdir(parents=True, exist_ok=True)
        pid = slug(a.save)
        (PROFILES / f'{pid}.json').write_text(json.dumps({**st, 'name': a.save, 'profile': pid, 'wallpaper': wall}, indent=1))
        st['profile'] = pid
        atomic(STATE, json.dumps(st, indent=1))
        write_catalog(st, hue, wall)
        print(f'Saved {a.save}')
        return
    if a.delete:
        f = PROFILES / f'{slug(a.delete)}.json'
        if not f.exists():
            sys.exit(f'No saved profile called {a.delete}; built-in profiles cannot be deleted.')
        f.unlink()
        if st.get('profile') == slug(a.delete):
            st['profile'] = ''
            atomic(STATE, json.dumps(st, indent=1))
        write_catalog(st, hue, wall)
        return

    syncing = False
    if a.profile:
        saved = saved_profiles().get(a.profile)
        if saved:
            st.update({k: saved[k] for k in DEFAULTS if k in saved})
            st['profile'] = a.profile
            if saved.get('wallpaper') and Path(saved['wallpaper']).exists():
                wall = saved['wallpaper']
                hue = seed_hue(wall)
                set_wallpaper(wall)
        elif a.profile in BUILTIN:
            _, pal, var, motion, corners, border, mode = BUILTIN[a.profile]
            st.update(palette=pal, variant=var, motion=motion, corners=corners, border=border, mode=mode, profile=a.profile)
        else:
            sys.exit(f'No profile called {a.profile}. See caelestia-scheme --list')
        syncing = True
    for k in ('palette', 'variant', 'mode', 'motion', 'corners', 'border'):
        v = getattr(a, k)
        if v is not None:
            st[k] = v
            st['profile'] = ''  # A hand-tuned look is no longer the named profile.
            syncing = True
    # A published palette has one fixed mode; follow it so the app chrome agrees.
    if a.palette and a.palette in PALETTES:
        st['mode'] = PALETTES[a.palette][1]
    if a.mode and st['palette'] in PALETTES:
        twin = {'catppuccin-latte': 'catppuccin-mocha', 'catppuccin-mocha': 'catppuccin-latte',
                'rose-pine-dawn': 'rose-pine', 'rose-pine': 'rose-pine-dawn'}.get(st['palette'])
        if PALETTES[st['palette']][1] != a.mode and twin:
            st['palette'] = twin
        elif PALETTES[st['palette']][1] != a.mode:
            st['palette'] = 'dynamic'

    mode = st['mode']
    s = colours_for(st, hue)
    tokens = {'border': BORDER.get(st['border'], 10), 'rounding': RADIUS.get(st['corners'], 25), 'motion': st['motion']}
    atomic(OUT / 'shell.css', shell_css(s, tokens, mode))
    shell_theme = HOME / '.themes/Caelestia/gnome-shell/gnome-shell.css'
    atomic(shell_theme, fill((EXT / 'shell-theme.tpl.css').read_text(), s))
    for gtk in ('gtk-4.0', 'gtk-3.0'):
        atomic(HOME / '.config' / gtk / 'caelestia.css', gtk_css(s))
    atomic(HOME / '.local/share/org.gnome.Ptyxis/palettes/caelestia.palette', ptyxis(s))
    atomic(STATE, json.dumps(st, indent=1))
    write_catalog(st, hue, wall)
    if syncing:
        sync_gnome(s, mode)
    # Written last: this is the file the extension watches.
    atomic(OUT / 'scheme.json', json.dumps({'wallpaper': wall, 'colors': s, 'tokens': tokens, 'mode': mode}, indent=1))
    print(f"{wall}: {st['palette']} {mode}, primary {s['primary']}, surface {s['surface']}")


if __name__ == '__main__':
    main()
