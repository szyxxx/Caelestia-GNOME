#!/usr/bin/python3
"""Theme the whole desktop from a wallpaper or a named palette, and manage rice profiles.

  caelestia-scheme [wallpaper]        rebuild with the current choices
  caelestia-scheme --list             print profiles and palettes
  caelestia-scheme --profile NAME     apply a rice profile
  caelestia-scheme --palette ID       catppuccin-mocha, tokyo-night, ... or dynamic (from wallpaper)
  caelestia-scheme --variant V        tonalspot, vibrant, expressive, fruitsalad, rainbow, neutral, monochrome
  caelestia-scheme --mode M           dark, light
  caelestia-scheme --motion M         fluid, expressive, calm, snappy, off
  caelestia-scheme --corners C        round, soft, sharp
  caelestia-scheme --border B         normal, thin
  caelestia-scheme --save NAME        save the current look, wallpaper included, as a profile
  caelestia-scheme --delete NAME      remove a saved profile

Writes ~/.local/share/caelestia-rice/{scheme.json,shell.css,themes.json}, the Caelestia shell
theme in ~/.themes, the GTK colour overrides and the Ptyxis terminal palette. The extension
watches scheme.json and restyles itself live. Your choices live in ~/.config/caelestia-gnome.
"""
import argparse, colorsys, hashlib, json, math, os, re, subprocess, sys, tempfile
from pathlib import Path
from urllib.parse import unquote, urlparse

