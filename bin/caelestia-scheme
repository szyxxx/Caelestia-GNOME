OUT = HOME / '.local/share/caelestia-rice'
EXT = HOME / '.local/share/gnome-shell/extensions/caelestia-gnome@szyx'
CONFIG = HOME / '.config/caelestia-gnome'
STATE = CONFIG / 'theme.json'
PROFILES = CONFIG / 'profiles'
THUMBS = HOME / '.cache/caelestia-gnome/thumbs'
WALL_DIRS = [HOME / '.local/share/backgrounds', HOME / 'Pictures/Wallpapers']
RADIUS = {'round': 25, 'soft': 14, 'sharp': 6}
BORDER = {'normal': 10, 'thin': 5}
DEFAULTS = {'palette': 'dynamic', 'variant': 'tonalspot', 'mode': 'dark', 'motion': 'fluid',
            'corners': 'round', 'border': 'normal', 'profile': 'caelestia'}

